<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.brandmultiplier.agent-hud</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/chris.rubin/.agent-hud/launch-hud.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart if it crashes, but respect a deliberate Quit. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>ProcessType</key>
  <string>Interactive</string>

  <key>StandardOutPath</key>
  <string>/Users/chris.rubin/.agent-hud/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/chris.rubin/.agent-hud/launchd.log</string>
</dict>
</plist>
